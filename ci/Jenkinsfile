// Jenkinsfile — single-VM version.
// Jenkins, Docker, and the deployed app all live on the same RHEL host,
// so there's no registry push and no SSH deploy step: Jenkins builds the
// image locally and runs `docker compose up -d` directly.

pipeline {
  agent any

  tools {
    maven 'Maven3'   // name must match Manage Jenkins > Tools > Maven installations
    jdk 'jdk17'      // name must match Manage Jenkins > Tools > JDK installations
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    APP_NAME       = 'demo-app'
    IMAGE_TAG      = "${env.BUILD_NUMBER}"
    SONAR_HOST_URL = 'http://localhost:9000'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build & Unit Test (Maven)') {
      steps {
        dir('app') {
          sh 'mvn -B clean verify'
        }
      }
      post {
        always {
          junit 'app/target/surefire-reports/*.xml'
          jacoco execPattern: 'app/target/jacoco.exec'
        }
      }
    }

    stage('SonarQube Static Analysis') {
      steps {
        dir('app') {
          withSonarQubeEnv('sonarqube-server') {
            sh """
              mvn -B sonar:sonar \
                -Dsonar.projectKey=${APP_NAME} \
                -Dsonar.host.url=${SONAR_HOST_URL}
            """
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('SAST / Dependency Scan') {
      steps {
        dir('app') {
          sh 'mvn -B dependency-check:check'
        }
      }
      post {
        always {
          dependencyCheckPublisher pattern: 'app/target/dependency-check-report.xml'
        }
      }
    }

    stage('Docker Build') {
      steps {
        dir('app') {
          sh "docker build -t ${APP_NAME}:${IMAGE_TAG} -t ${APP_NAME}:latest ."
        }
      }
    }

    stage('Trivy Image Scan') {
      steps {
        sh """
          trivy image \
            --severity HIGH,CRITICAL \
            --exit-code 1 \
            --format table \
            ${APP_NAME}:${IMAGE_TAG}
        """
      }
    }

    stage('Deploy (local Docker Compose)') {
      steps {
        sh 'docker compose up -d'
      }
    }
  }

  post {
    success {
      echo "Pipeline succeeded: ${APP_NAME}:${IMAGE_TAG} built and deployed locally."
    }
    failure {
      echo "Pipeline failed — check the stage above. Nothing was (re)deployed."
    }
  }
}
