{
  "title": "Demo App Overview",
  "uid": "demo-app-overview",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"demo-app\"}[5m])) by (uri)" }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"demo-app\", status=~\"5..\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"demo-app\", area=\"heap\"}" }
      ]
    },
    {
      "id": 4,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(process_cpu_usage{application=\"demo-app\"}[5m])" }
      ]
    }
  ]
}
